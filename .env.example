# ==========================================
# Online Test System - Environment Variables
# ==========================================

# --- Backend Configuration ---
# Set these variables if running backend natively without Docker

# Database Settings
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ots_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=ots_user
SPRING_DATASOURCE_PASSWORD=ots_password

# Authentication
# IMPORTANT: Generate a strong base64 or long string secret securely in production
JWT_SECRET=c2VjcmV0a2V5Zm9yb25saW5ldGVzdHN5c3RlbTIwMjRqd3Rfc2VjcmV0a2V5X3N0cmluZw==
JWT_EXPIRATION=86400000

# CORS & Gateway
FRONTEND_URL=http://localhost:5173

# Code Runner (disabled by default for safety)
CODE_RUNNER_ENABLED=false

# Bootstrap Admin (disable in production or set secure credentials)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Docker Configuration ---
# These credentials will be used specifically by Docker Compose 
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ots_db
MYSQL_USER=ots_user
MYSQL_PASSWORD=ots_password
